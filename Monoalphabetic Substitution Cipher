#include <stdio.h>
#include <ctype.h>
#include <string.h>
int main() {
    char text[100], key[27];
    int i, j, valid;
    printf("Enter the substitution key (26 letters): ");
    scanf("%26s", key);
    if (strlen(key) != 26) {
        printf("Invalid key");
        return 0;
    }
    for (i = 0; i < 26; i++) {
        key[i] = toupper(key[i]);
        if (key[i] < 'A' || key[i] > 'Z') {
            printf("Invalid key");
            return 0;
        }
        for (j = 0; j < i; j++) {
            if (key[i] == key[j]) {
                printf("Key must contain unique letters");
                return 0;
            }
        }
    }
    getchar();
    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);
    for (i = 0; text[i] != '\0'; i++) {
        if (isupper((unsigned char)text[i]))
            text[i] = key[text[i] - 'A'];
        else if (islower((unsigned char)text[i]))
            text[i] = tolower(key[text[i] - 'a']);
    }
    printf("Encrypted text: %s", text);
    return 0;
}

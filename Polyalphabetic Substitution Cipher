#include <stdio.h>
#include <string.h>
#include <ctype.h>
int main() {
    char text[100], key[100];
    int i, j = 0, k;
    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);
    printf("Enter key: ");
    fgets(key, sizeof(key), stdin);
    key[strcspn(key, "\n")] = '\0';
    if (strlen(key) == 0) {
        printf("Invalid key");
        return 0;
    }
    for (i = 0; text[i] != '\0'; i++) {
        if (isalpha((unsigned char)text[i])) {
            k = toupper((unsigned char)key[j % strlen(key)]) - 'A';
            if (isupper((unsigned char)text[i]))
                text[i] = (text[i] - 'A' + k) % 26 + 'A';
            else
                text[i] = (text[i] - 'a' + k) % 26 + 'a';
            j++;
        }
    }
    printf("Encrypted text: %s", text);
    return 0;
}
